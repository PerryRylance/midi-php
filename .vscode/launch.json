	"version": "0.2.0",
	"configurations": [
		{
			"name": "Listen for Xdebug (in Docker)",
			"type": "php",
			"request": "launch",
			"hostname": "127.0.0.1",
			"port": 9003,
			"pathMappings": {
				"/app": "${workspaceRoot}/"
			},
			"xdebugSettings": {
				"max_data": -1
			}
		},
		{
			"name": "Listen for Xdebug",
			"type": "php",
			"request": "launch",
			"port": 9003,
			"xdebugSettings": {
				"max_data": -1,
				"show_local_vars": 0
			}
		}
	]
}
