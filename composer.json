{
    "name": "perry-rylance/midi-php",
    "description": "Read, build and write MIDI files, tracks and events in PHP",
    "authors": [
        {
            "name": "Perry Rylance",
            "email": "contact@perryrylance.dev",
            "homepage": "https://perryrylance.dev",
            "role": "Developer"
        }
    ],
    "type": "library",
    "keywords": ["MIDI"],
    "homepage": "https://github.com/PerryRylance/midi-php",
    "license": "MIT",
    "version": "1.0.0",
    "minimum-stability": "stable",
    "require-dev": {
        "pestphp/pest": "^3.8",
        "illuminate/support": "^12.20",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.84"
    },
    "autoload": {
        "psr-4": {
            "PerryRylance\\Midi\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest",
        "lint": "./vendor/bin/phpstan analyse includes --memory-limit=256M",
        "format": "./vendor/bin/php-cs-fixer fix includes --config=./.php-cs-fixer.php"
    },
    "require": {
        "php": ">=8.2.0",
        "aeviiq/collection": "^4.0"
    }
}
